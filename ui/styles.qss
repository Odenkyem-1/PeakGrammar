/* ==========================================================================
   PeakGrammar - Modern Dark Periwinkle & Obsidian Slate Stylesheet
   Inspired by Refinement Studio design: deep charcoal, sleek cards,
   vibrant periwinkle indigo accents, and coral/amber status indicators.
   ========================================================================== */

/* --- Global Base --- */
QWidget {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "SF Pro Text", Roboto, sans-serif;
    font-size: 13px;
    color: #f0f1f6;
    background-color: transparent;
}

QDialog, QMainWindow, QWidget#refinementStudio {
    background-color: #0d0e12;
}

/* --- Cards and Containers --- */
#card, QFrame#card {
    background-color: #121319;
    border-radius: 16px;
    border: 1px solid #222432;
    padding: 16px;
}

#cardSecondary, QFrame#cardSecondary {
    background-color: #171923;
    border-radius: 12px;
    border: 1px solid #262836;
    padding: 10px 12px;
}

/* --- Floating Suggestion Card --- */
#suggestionCard {
    background-color: #14151d;
    border-radius: 16px;
    border: 1px solid #2a2d3e;
    padding: 14px 16px;
}

/* --- Status Badges (Smooth Rounded Pills) --- */
#badgeSpelling {
    background-color: #2b171c;
    color: #f87171;
    border: 1px solid #4a242c;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#badgeGrammar {
    background-color: #2b171c;
    color: #f87171;
    border: 1px solid #4a242c;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#badgeClarity {
    background-color: #292015;
    color: #fbbf24;
    border: 1px solid #48351a;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
}

#badgeLLM {
    background-color: #1a2038;
    color: #9db0fc;
    border: 1px solid #324075;
    border-radius: 10px;
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 700;
}

/* --- Buttons (Round Edges) --- */
QPushButton {
    background-color: #1a1c26;
    color: #e2e4ee;
    border: 1px solid #282a38;
    border-radius: 14px;
    padding: 6px 16px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #252836;
    border-color: #353849;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1f212d;
}

QPushButton:disabled {
    background-color: #14151d;
    color: #555768;
    border-color: #1d1f2a;
}

/* Primary Action Button (Periwinkle Accent CTA Pill) */
QPushButton#primary, QPushButton[primary="true"] {
    background-color: #9db0fc;
    color: #0c0e16;
    border: 1px solid #9db0fc;
    font-weight: 700;
    border-radius: 16px;
    padding: 7px 20px;
}

QPushButton#primary:hover, QPushButton[primary="true"]:hover {
    background-color: #b0c0fd;
    border-color: #b0c0fd;
    color: #0c0e16;
}

QPushButton#primary:pressed, QPushButton[primary="true"]:pressed {
    background-color: #8b9cfc;
}

/* Item Action Buttons (Suggestions List Pills) */
QPushButton#acceptBtn {
    background-color: #9db0fc;
    color: #0c0e16;
    border: 1px solid #9db0fc;
    font-weight: 700;
    border-radius: 14px;
    padding: 6px 18px;
    font-size: 12px;
}

QPushButton#acceptBtn:hover {
    background-color: #b2c2fd;
    border-color: #b2c2fd;
}

QPushButton#acceptBtn:pressed {
    background-color: #8b9cfc;
}

QPushButton#dismissBtn {
    background-color: #212330;
    color: #c2c5d4;
    border: 1px solid #2d3040;
    font-weight: 500;
    border-radius: 14px;
    padding: 6px 18px;
    font-size: 12px;
}

QPushButton#dismissBtn:hover {
    background-color: #2c2f3e;
    color: #ffffff;
}

/* Subtle / Ghost Button */
QPushButton#subtle {
    background-color: transparent;
    border: 1px solid transparent;
    color: #8b8f9f;
}

QPushButton#subtle:hover {
    background-color: #1b1c26;
    color: #f0f1f6;
    border-color: #262836;
}

/* Tone Pills */
QPushButton#tonePill {
    background-color: #16171f;
    border: 1px solid #232530;
    color: #8c90a2;
    border-radius: 14px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton#tonePill:hover {
    background-color: #1d1e28;
    color: #d1d4e4;
    border-color: #2d303f;
}

QPushButton#tonePillActive {
    background-color: #1b223d;
    border: 1px solid #3c4b8e;
    color: #9db0fc;
    border-radius: 14px;
    padding: 4px 14px;
    font-size: 12px;
    font-weight: 600;
}

/* --- Input Fields & Editors --- */
QTextEdit, QPlainTextEdit {
    background-color: transparent;
    border: none;
    padding: 6px 0;
    font-size: 15px;
    line-height: 1.6;
    color: #f0f1f6;
    selection-background-color: #2c3558;
    selection-color: #ffffff;
}

QLineEdit {
    background-color: #161720;
    border: 1px solid #282a39;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    color: #f0f1f6;
    selection-background-color: #2c3558;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #9db0fc;
}

/* --- Dropdown Menus (QComboBox) --- */
QComboBox {
    background-color: #161720;
    border: 1px solid #282a39;
    border-radius: 8px;
    padding: 6px 12px;
    color: #f0f1f6;
    font-weight: 500;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #383b50;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #161720;
    border: 1px solid #282a39;
    border-radius: 8px;
    selection-background-color: #232635;
    selection-color: #9db0fc;
    padding: 4px;
}

/* --- Slim Metric Progress Bars --- */
QProgressBar {
    background-color: #1e202b;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: right;
    font-size: 1px;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #8b9cfc;
    border-radius: 3px;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #222432;
    background-color: #121319;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #7b7f92;
    padding: 9px 18px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #9db0fc;
    font-weight: 600;
    border-bottom: 2px solid #9db0fc;
}

QTabBar::tab:hover:!selected {
    color: #d1d4e4;
}

/* --- Tables & Lists --- */
QTableWidget, QListView, QListWidget {
    background-color: #14151d;
    border: 1px solid #242635;
    border-radius: 8px;
    gridline-color: #1e202b;
    selection-background-color: #202332;
    selection-color: #ffffff;
    color: #e2e4ee;
}

QHeaderView::section {
    background-color: #181923;
    color: #8b8f9f;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #242635;
    font-weight: 600;
    font-size: 11px;
}

/* --- Checkboxes & Radios --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #e2e4ee;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #36384a;
    background-color: #161720;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #9db0fc;
    border-color: #9db0fc;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 6px;
    margin: 0;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: #282a39;
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #3c3f54;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
