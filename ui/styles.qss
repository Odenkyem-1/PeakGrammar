/* ==========================================================================
   PeakGrammar - Soft-UI Monochrome Stylesheet
   Pure black, white, charcoal, and balanced neutral gray palette.
   ========================================================================== */

/* --- Global Base --- */
QWidget {
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, Roboto, sans-serif;
    font-size: 13px;
    color: #18181b;
    background-color: transparent;
}

QDialog, QMainWindow {
    background-color: #f4f4f6;
}

/* --- Cards and Containers --- */
#card, QFrame#card {
    background-color: #ffffff;
    border-radius: 14px;
    border: 1px solid #e4e4e7;
    padding: 14px;
}

#cardSecondary, QFrame#cardSecondary {
    background-color: #fafafa;
    border-radius: 12px;
    border: 1px solid #ededf0;
    padding: 10px;
}

/* --- Floating Suggestion Card --- */
#suggestionCard {
    background-color: #ffffff;
    border-radius: 14px;
    border: 1px solid #d4d4d8;
    padding: 12px 14px;
}

#badgeSpelling {
    background-color: #18181b;
    color: #ffffff;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

#badgeGrammar {
    background-color: #3f3f46;
    color: #ffffff;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 600;
}

#badgeLLM {
    background-color: #000000;
    color: #ffffff;
    border-radius: 6px;
    padding: 2px 8px;
    font-size: 11px;
    font-weight: 700;
}

/* --- Buttons --- */
QPushButton {
    background-color: #f4f4f6;
    color: #18181b;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #e4e4e7;
    border-color: #d4d4d8;
}

QPushButton:pressed {
    background-color: #d4d4d8;
}

QPushButton:disabled {
    background-color: #f4f4f6;
    color: #a1a1aa;
    border-color: #f4f4f6;
}

/* Primary Action Button (Pure Black CTA) */
QPushButton#primary, QPushButton[primary="true"] {
    background-color: #000000;
    color: #ffffff;
    border: 1px solid #000000;
    font-weight: 600;
}

QPushButton#primary:hover, QPushButton[primary="true"]:hover {
    background-color: #27272a;
    border-color: #27272a;
}

QPushButton#primary:pressed, QPushButton[primary="true"]:pressed {
    background-color: #3f3f46;
}

/* Subtle Secondary / Ghost Button */
QPushButton#subtle {
    background-color: transparent;
    border: 1px solid transparent;
    color: #71717a;
}

QPushButton#subtle:hover {
    background-color: #f4f4f6;
    color: #18181b;
    border-color: #e4e4e7;
}

/* --- Input Fields & Editors --- */
QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 10px;
    padding: 12px;
    font-size: 14px;
    line-height: 1.5;
    color: #18181b;
    selection-background-color: #18181b;
    selection-color: #ffffff;
}

QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #18181b;
}

QLineEdit {
    background-color: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    padding: 7px 12px;
    font-size: 13px;
    color: #18181b;
    selection-background-color: #18181b;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 1px solid #18181b;
}

/* --- Dropdown Menus (QComboBox) --- */
QComboBox {
    background-color: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    padding: 6px 12px;
    color: #18181b;
    font-weight: 500;
    min-width: 120px;
}

QComboBox:hover {
    border-color: #d4d4d8;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    selection-background-color: #f4f4f6;
    selection-color: #18181b;
    padding: 4px;
}

/* --- Progress Bar (Writing Score) --- */
QProgressBar {
    background-color: #e4e4e7;
    border: none;
    border-radius: 6px;
    height: 12px;
    text-align: right;
    font-size: 11px;
    font-weight: 600;
    color: #71717a;
}

QProgressBar::chunk {
    background-color: #18181b;
    border-radius: 6px;
}

/* --- Tabs --- */
QTabWidget::pane {
    border: 1px solid #e4e4e7;
    background-color: #ffffff;
    border-radius: 10px;
    top: -1px;
}

QTabBar::tab {
    background-color: transparent;
    color: #71717a;
    padding: 8px 16px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: 500;
}

QTabBar::tab:selected {
    color: #18181b;
    font-weight: 600;
    border-bottom: 2px solid #000000;
}

QTabBar::tab:hover:!selected {
    color: #27272a;
}

/* --- Tables & Lists --- */
QTableWidget, QListView, QListWidget {
    background-color: #ffffff;
    border: 1px solid #e4e4e7;
    border-radius: 8px;
    gridline-color: #f4f4f6;
    selection-background-color: #f4f4f6;
    selection-color: #18181b;
}

QHeaderView::section {
    background-color: #fafafa;
    color: #71717a;
    padding: 6px 10px;
    border: none;
    border-bottom: 1px solid #e4e4e7;
    font-weight: 600;
    font-size: 11px;
}

/* --- Checkboxes & Radios --- */
QCheckBox, QRadioButton {
    spacing: 8px;
    color: #18181b;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #d4d4d8;
    background-color: #ffffff;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #000000;
    border-color: #000000;
}

/* --- Scrollbars --- */
QScrollBar:vertical {
    border: none;
    background: #f4f4f6;
    width: 8px;
    margin: 0;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background: #d4d4d8;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #a1a1aa;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}
